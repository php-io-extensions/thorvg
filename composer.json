{
    "name": "php-io-extensions/thorvg",
    "type": "php-ext",
    "description": "1:1 PHP bindings of ThorVG 1.1.3's C API, a 2D vector graphics engine (shapes, paints, scenes, gradients, masks, effects, text, SVG and image loading, video, GIF saving) on its CPU renderer, compiled into the extension",
    "keywords": [
        "thorvg",
        "vector-graphics",
        "rasterizer",
        "svg",
        "2d",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "thorvg",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-thorvg",
                "description": "Enable the ThorVG 1.1.3 bindings",
                "needs-value": false
            }
        ]
    }
}
